table _Medidas
	lineageTag: bb59ba53-3f78-4fd1-8b44-22a5455a6a52

	measure 'Produtos por Associado' = AVERAGE(Fato_Associados[QTD_PRODUTOS])
		formatString: #,##0.00
		displayFolder: Médias
		lineageTag: ca24233f-4193-4f9b-8ddf-8977b34d9b57

	measure 'Renda Média' = AVERAGE(Fato_Associados[RENDA_MENSAL])
		formatString: "R$"\ #,##0.00
		displayFolder: Médias
		lineageTag: 2b357193-7d58-4761-ba9f-476943a69ad4

	measure 'Saldo Médio' = AVERAGE(Fato_Associados[SALDO_MEDIO])
		formatString: "R$"\ #,##0.00
		displayFolder: Médias
		lineageTag: caa9ebd3-4587-4542-9ba3-6a4c219619b7

	measure 'Total de Associados' = DISTINCTCOUNT(Fato_Associados[CHAVE])
		formatString: 0
		displayFolder: #Contagens
		lineageTag: b3a9cbde-c4a9-4c56-9a37-171e62d0613b

	measure 'Tempo Médio de Relacionamento (Anos)' = AVERAGE(Fato_Associados[TEMPO_RELACIONAMENTO_ANOS])
		formatString: #,##0.00
		displayFolder: Médias
		lineageTag: 6f2ba6e3-9a9d-4a4f-8d61-3ea8b74a5b12

	measure '% de Associados' = DIVIDE([Total de Associados], CALCULATE([Total de Associados], ALL(Fato_Associados)))
		formatString: 0.0%
		displayFolder: #Contagens
		lineageTag: 9a1e5c7f-3d2b-4c6a-8e4f-1b7c9d3a5f60

	measure 'Oportunidades - Alta Renda Poucos Produtos' = CALCULATE([Total de Associados], Fato_Associados[FLAG_OPORTUNIDADE_ALTA_RENDA_POUCOS_PRODUTOS] = TRUE)
		formatString: 0
		displayFolder: Oportunidades
		lineageTag: d4e7f0a3-8b1c-4d5e-9f2a-6b3c8e1f4a72

	measure 'Oportunidades - Baixa Utilização' = CALCULATE([Total de Associados], Fato_Associados[FLAG_OPORTUNIDADE_BAIXA_UTILIZACAO] = TRUE)
		formatString: 0
		displayFolder: Oportunidades
		lineageTag: e5f8a1b4-9c2d-4e6f-a03b-7c4d9f2a5b83

	measure 'Oportunidades - Potencial de Crescimento' = CALCULATE([Total de Associados], Fato_Associados[FLAG_OPORTUNIDADE_POTENCIAL_CRESCIMENTO] = TRUE)
		formatString: 0
		displayFolder: Oportunidades
		lineageTag: f6a9b2c5-ad3e-4f70-b14c-8d5eaf3b6c94

	partition _Medidas = m
		mode: import
		source =
				let
				    Fonte = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Coluna 1" = _t]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"Coluna 1", type text}}),
				    #"Colunas Removidas" = Table.RemoveColumns(#"Tipo Alterado",{"Coluna 1"})
				in
				    #"Colunas Removidas"

	annotation PBI_ResultType = Table

